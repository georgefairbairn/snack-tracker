rules_version = '2';

// These rules are the ONLY access control on this database. There is no
// sign-in — see docs/adr/0003. Replacing any of this with `allow write: if true`
// while debugging turns a bounded nuisance into total data loss. Don't.
service cloud.firestore {
  match /databases/{database}/documents {

    // A date key must be exactly YYYY-MM-DD before we try to parse it.
    function wellFormedDate(d) {
      return d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function asTimestamp(d) {
      return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]));
    }

    // The backfill window is 3 days, but these rules run in UTC while Days are
    // local and roll over at 4am. The extra slack absorbs that difference
    // rather than rejecting a legitimate write near a boundary.
    function insideBackfillWindow(d) {
      return asTimestamp(d) > request.time - duration.value(5, 'd')
          && asTimestamp(d) < request.time + duration.value(2, 'd');
    }

    // The Culprit categories, mirroring js/culprits.js. A Culprit list is
    // bounded and drawn only from these keys, so the worst a stranger can store
    // here is a short list of known words.
    function validCulprits(list) {
      return list is list
          && list.size() <= 6
          && list.hasOnly(['sweet', 'savoury', 'takeout', 'alcohol', 'eatingout', 'fizzy']);
    }

    // Only the two Players, only the three Ratings, and each Player's optional
    // Culprit list — nothing else in the document. Written out per Player rather
    // than looked up by a variable key, so it uses nothing beyond plainly
    // supported rules syntax.
    //
    // This is shape validation, not bookkeeping: it does not check that a
    // Culprit list sits on a yellow or red Day. Enforcing that here would reject
    // legitimate writes at no security gain — a Culprit list on a green Day is
    // already inside the blast radius a stranger has (docs/adr/0003), and the
    // app clears the list in the same write that turns a Day green.
    function validShape(data) {
      return data.keys().hasOnly(['george', 'izzy', 'georgeCulprits', 'izzyCulprits'])
          && data.keys().size() > 0
          && (!('george' in data) || data.george in ['red', 'yellow', 'green'])
          && (!('izzy' in data) || data.izzy in ['red', 'yellow', 'green'])
          && (!('georgeCulprits' in data) || validCulprits(data.georgeCulprits))
          && (!('izzyCulprits' in data) || validCulprits(data.izzyCulprits));
    }

    match /days/{date} {
      allow read: if true;
      allow create, update: if wellFormedDate(date)
                            && insideBackfillWindow(date)
                            && validShape(request.resource.data);
      // History is immutable. Nothing is ever deleted.
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
